# Truestorey — environment
# Copy to .env.local. Never commit .env.local.
#
# EVERY LINE HERE IS OPTIONAL. The site runs with none of them: the datasets
# are in the repo, the calculators are arithmetic, and Blindspot's score comes
# from a published rubric rather than a model. What the keys add is the layer
# on top — retrieval, prose, floor plans, and the article pipeline.

# ── already in use ──────────────────────────────────────────────────────────
URA_ACCESS_KEY=                 # free: eservice.ura.gov.sg/maps/api/reg.html
                                # used by ingest:ura and ingest:rental

# ── articles pipeline ───────────────────────────────────────────────────────
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_…  read-only under RLS. Safe to expose.
SUPABASE_SECRET_KEY=            # sb_secret_…       BYPASSES RLS. Server only.
                                # Never NEXT_PUBLIC_. Never in a screenshot.
# The older SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY names still work.
ARTICLE_WEBHOOK_SECRET=         # long random string; Make.com sends it as Bearer
STUDIO_PASSWORD=                # HTTP Basic on /studio. Unset = /studio is closed.
UNSPLASH_ACCESS_KEY=            # for the download ping their licence requires

# ── the AI engines ──────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=             # /neighbourhood, and GLS facts in Blindspot
ANTHROPIC_API_KEY=              # the Blindspot summary paragraph
GEMINI_API_KEY=                 # /floorplan

# Each is checked independently. A missing key disables its own feature and
# nothing else: /floorplan says it is not configured, Blindspot drops its
# paragraph and keeps its score.

# OneMap geocoding token (optional today). https://www.onemap.gov.sg/apidocs/
ONEMAP_TOKEN=
